<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Azure DevOps mirror also used by microsoft/aspire for released packages. -->
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="aspire-staging" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/darc-pub-microsoft-aspire-34db30a7/nuget/v3/index.json" />
  </packageSources>
  <auditSources>
    <clear />
    <!-- This endpoint serves vulnerability data only, not packages. -->
    <add key="nuget.org" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <clear />
    <!-- Keep packages on the approved feed even if the Aspire CLI adds channel sources. -->
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="aspire-staging">
      <package pattern="Aspire.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
