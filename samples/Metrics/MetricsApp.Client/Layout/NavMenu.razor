@implements IDisposable
@inject ShopSession Shop

@*
    Primary navigation rendered as horizontal "console tabs" in the app bar.
*@
<nav class="topnav" aria-label="Primary">
    <NavLink class="topnav__link" href="" Match="NavLinkMatch.All">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 13h3l2-4 3 8 2.5-6 1.5 2h6" />
        </svg>
        <span>Live orders</span>
    </NavLink>
    <NavLink class="topnav__link" href="shop">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <span>Shop</span>
        @if (Shop.ItemCount > 0)
        {
            <span class="topnav__badge" aria-label="@($"{Shop.ItemCount} items in cart")">@Shop.ItemCount</span>
        }
    </NavLink>
    <NavLink class="topnav__link" href="auth">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
        </svg>
        <AuthorizeView>
            <Authorized><span>Account</span></Authorized>
            <NotAuthorized><span>Sign in</span></NotAuthorized>
        </AuthorizeView>
    </NavLink>
</nav>

@code {
    protected override void OnInitialized() => Shop.Changed += OnShopChanged;

    private void OnShopChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shop.Changed -= OnShopChanged;
}
