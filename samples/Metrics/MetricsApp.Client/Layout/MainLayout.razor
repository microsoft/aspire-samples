@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to main content</a>

<div class="console">
    <header class="appbar">
        <a class="brand" href="">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
                </svg>
            </span>
            <span class="brand__text">
                <span class="brand__name">Contoso Outfitters</span>
                <span class="brand__sub">Checkout · OpenTelemetry</span>
            </span>
        </a>

        <NavMenu />

        <span class="appbar__status chip" title="Every checkout emits OpenTelemetry metrics">
            <span class="dot" aria-hidden="true"></span> live
        </span>
    </header>

    <main id="main" class="content" tabindex="-1">
        @Body
    </main>
</div>
