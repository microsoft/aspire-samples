@page "/cart"

@inject BasketServiceClient BasketClient
@inject CatalogServiceClient CatalogService
@inject NavigationManager Navigation

<PageTitle>Aspire Shop · Your cart</PageTitle>

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/" aria-label="Aspire Shop, home">
            <span class="brand-mark" aria-hidden="true">@Icons.Storefront</span>
            <span class="brand-words">
                <span class="brand-kicker">Aspire</span>
                <span class="brand-name">Shop</span>
            </span>
        </a>
        <p class="brand-tagline">Review the items the Basket service is holding for you</p>
        <div class="topbar-actions">
            <a class="continue-link" href="/">
                <span class="continue-icon" aria-hidden="true">@Icons.ArrowLeft</span>
                <span>Continue shopping</span>
            </a>
            <ThemeToggle />
        </div>
    </div>
</header>

<main id="main-content" class="shell">
    <section class="collection-head collection-head--left">
        @if (order is null)
        {
            <p class="eyebrow">Your cart</p>
            <h1 class="collection-title cart-title">Your cart</h1>
            <p class="collection-sub">Items are held by the Basket service over gRPC. Prices come from the Catalog service.</p>
        }
        else
        {
            <p class="eyebrow">Checkout complete</p>
            <h1 class="collection-title cart-title">Thanks for your order</h1>
            <p class="collection-sub">The Basket service created order @order.OrderId over gRPC and cleared your cart.</p>
        }
    </section>

    @if (loaded)
    {
        @if (!basketIsAvailable)
        {
            <div class="cart-notice" role="status">
                <span class="cart-notice-icon" aria-hidden="true">@Icons.Handbag</span>
                <div>
                    <p class="cart-notice-title">The Basket service is unavailable</p>
                    <p class="cart-notice-text">Your cart can't be loaded right now. Start the Basket service and try again.</p>
                </div>
            </div>
        }
        else if (order is not null)
        {
            <div class="cart-layout">
                <ul class="cart-lines" aria-label="Items in this order">
                    @foreach (var line in lines)
                    {
                        <li class="cart-line @(line.Item is null ? "is-unavailable" : null)">
                            <div class="cart-line-media">
                                @if (line.Item is not null)
                                {
                                    <img src="catalog/images/@line.ProductId" alt="@line.Item.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="cart-line-media-fallback" aria-hidden="true">@Icons.Handbag</span>
                                }
                            </div>
                            <div class="cart-line-info">
                                @if (line.Item?.CatalogBrand is { Brand: var brand })
                                {
                                    <p class="cart-line-brand">@brand</p>
                                }
                                <h2 class="cart-line-name">@(line.Item?.Name ?? "Item no longer available")</h2>
                                <p class="cart-line-unit">@line.Quantity × @line.UnitPrice.ToString("C")</p>
                            </div>
                            <p class="cart-line-total">@line.Total.ToString("C")</p>
                        </li>
                    }
                </ul>

                <aside class="cart-summary" aria-label="Order confirmation">
                    <span class="cart-empty-icon cart-empty-icon--ok" aria-hidden="true">@Icons.Check</span>
                    <h2 class="summary-title">Order placed</h2>
                    <dl class="summary-rows">
                        <div class="summary-row">
                            <dt>Order number</dt>
                            <dd>@order.OrderId</dd>
                        </div>
                        <div class="summary-row">
                            <dt>Items</dt>
                            <dd>@order.ItemCount</dd>
                        </div>
                        <div class="summary-row summary-row--total">
                            <dt>Total</dt>
                            <dd>@order.Total.ToString("C")</dd>
                        </div>
                    </dl>
                    <p class="summary-note">The Basket service totaled the order from the prices captured when each item was added.</p>
                    <a class="btn btn-primary btn-block" href="/">Browse the catalog</a>
                </aside>
            </div>
        }
        else if (lines.Count == 0)
        {
            @* Keep the checkout form registered, so a checkout posted after this basket was already checked out
               (from another tab, or a double submit) is handled and rejected rather than failing with a 400 *@
            <EditForm Model="this" FormName="cart-checkout" OnValidSubmit="HandleCheckout" />

            <div class="cart-empty">
                <span class="cart-empty-icon" aria-hidden="true">@Icons.Handbag</span>
                <h2 class="cart-empty-title">Your cart is empty</h2>
                <p class="cart-empty-text">Add products from the catalog and they'll be saved here by the Basket service.</p>
                <a class="btn btn-primary" href="/">Browse the catalog</a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <ul class="cart-lines">
                    @foreach (var line in lines)
                    {
                        <li class="cart-line @(line.Item is null ? "is-unavailable" : null)">
                            <div class="cart-line-media">
                                @if (line.Item is not null)
                                {
                                    <img src="catalog/images/@line.ProductId" alt="@line.Item.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="cart-line-media-fallback" aria-hidden="true">@Icons.Handbag</span>
                                }
                            </div>

                            <div class="cart-line-info">
                                @if (line.Item is not null)
                                {
                                    @if (line.Item.CatalogBrand is { Brand: var brand })
                                    {
                                        <p class="cart-line-brand">@brand</p>
                                    }
                                    <h2 class="cart-line-name">@line.Item.Name</h2>
                                    <p class="cart-line-unit">@line.UnitPrice.ToString("C") each</p>
                                }
                                else
                                {
                                    <h2 class="cart-line-name">Item no longer available</h2>
                                    <p class="cart-line-unit">This product was removed from the catalog. Remove it to continue.</p>
                                }
                            </div>

                            <div class="cart-line-actions">
                                @if (line.Item is not null)
                                {
                                    <EditForm Model="this" FormName="@($"qty-{line.ProductId}")" OnValidSubmit="HandleLineAction" data-enhance data-preserve-scroll class="stepper-form">
                                        <input type="hidden" name="ProductId" value="@line.ProductId" />
                                        <div class="stepper" role="group" aria-label="@($"Quantity for {line.Item.Name}")">
                                            <button type="submit" name="Op" value="dec" class="stepper-btn"
                                                    aria-label="@($"Decrease quantity of {line.Item.Name}")">
                                                <span aria-hidden="true">@Icons.Minus</span>
                                            </button>
                                            <span class="stepper-value" aria-live="polite">@line.Quantity</span>
                                            <button type="submit" name="Op" value="inc" class="stepper-btn"
                                                    aria-label="@($"Increase quantity of {line.Item.Name}")">
                                                <span aria-hidden="true">@Icons.Plus</span>
                                            </button>
                                        </div>
                                        <button type="submit" name="Op" value="remove" class="line-remove"
                                                aria-label="@($"Remove {line.Item.Name} from cart")">
                                            <span aria-hidden="true">@Icons.Trash</span>
                                            <span class="line-remove-text">Remove</span>
                                        </button>
                                    </EditForm>

                                    <p class="cart-line-total" aria-label="@($"Line total {line.Total.ToString("C")}")">
                                        @line.Total.ToString("C")
                                    </p>
                                }
                                else
                                {
                                    <EditForm Model="this" FormName="@($"qty-{line.ProductId}")" OnValidSubmit="HandleLineAction" data-enhance data-preserve-scroll class="stepper-form">
                                        <input type="hidden" name="ProductId" value="@line.ProductId" />
                                        <button type="submit" name="Op" value="remove" class="line-remove"
                                                aria-label="Remove unavailable item from cart">
                                            <span aria-hidden="true">@Icons.Trash</span>
                                            <span class="line-remove-text">Remove</span>
                                        </button>
                                    </EditForm>
                                }
                            </div>
                        </li>
                    }
                </ul>

                <aside class="cart-summary" aria-label="Order summary">
                    <h2 class="summary-title">Summary</h2>
                    <dl class="summary-rows">
                        <div class="summary-row">
                            <dt>Items</dt>
                            <dd>@TotalItemCount</dd>
                        </div>
                        <div class="summary-row summary-row--total">
                            <dt>Subtotal</dt>
                            <dd>@Subtotal.ToString("C")</dd>
                        </div>
                    </dl>
                    <p class="summary-note">Prices were captured from the Catalog service when each item was added.</p>
                    @if (HasUnavailableItems)
                    {
                        <p class="summary-note">Remove items that are no longer available to check out.</p>
                    }

                    <EditForm Model="this" FormName="cart-checkout" OnValidSubmit="HandleCheckout" data-enhance>
                        <button type="submit" class="btn btn-primary btn-block" disabled="@HasUnavailableItems">
                            <span class="btn-icon" aria-hidden="true">@Icons.Check</span>
                            <span>Checkout</span>
                        </button>
                    </EditForm>
                    <EditForm Model="this" FormName="cart-clear" OnValidSubmit="HandleClear" data-enhance data-preserve-scroll>
                        <button type="submit" class="btn btn-ghost btn-block">Clear cart</button>
                    </EditForm>
                </aside>
            </div>
        }
    }
    else
    {
        <div class="catalog-loading" role="status" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <p>Loading your cart from the Basket service…</p>
        </div>
    }
</main>

<AppFooter />

@code {
    bool loaded;
    bool basketIsAvailable;
    List<CartLine> lines = new();
    OrderConfirmation? order;

    // Catalog entries for the products in the basket, or null for products that are no longer in the catalog
    readonly Dictionary<int, CatalogItem?> catalogItems = new();

    [SupplyParameterFromForm]
    public int ProductId { get; set; }

    [SupplyParameterFromForm]
    public string? Op { get; set; }

    int TotalItemCount => lines.Where(l => l.Item is not null).Sum(l => l.Quantity);

    decimal Subtotal => lines.Where(l => l.Item is not null).Sum(l => l.Total);

    bool HasUnavailableItems => lines.Any(l => l.Item is null);

    protected override async Task OnInitializedAsync()
    {
        var (basket, available) = await BasketClient.GetBasketAsync("user");
        basketIsAvailable = available;

        if (available && basket is { Items.Count: > 0 })
        {
            lines = await ToCartLinesAsync(basket.Items);

            if (lines.Any(l => l.UnitPrice <= 0 && l.Item is not null))
            {
                basket = await BasketClient.BackfillUnitPricesAsync(basket, catalogItems.Values.OfType<CatalogItem>());
                lines = await ToCartLinesAsync(basket.Items);
            }
        }

        loaded = true;
    }

    private async Task HandleLineAction()
    {
        switch (Op)
        {
            case "inc":
                await BasketClient.AdjustItemQuantityAsync("user", ProductId, 1);
                break;
            case "dec":
                await BasketClient.AdjustItemQuantityAsync("user", ProductId, -1);
                break;
            case "remove":
                await BasketClient.RemoveItemAsync("user", ProductId);
                break;
        }

        // Re-request the page so a freshly initialized component tree reflects the updated basket.
        // The forms are marked data-preserve-scroll so site.js keeps the scroll position across the
        // enhanced refresh.
        Navigation.Refresh();
    }

    private async Task HandleCheckout()
    {
        // Products that left the catalog can't be ordered, so they have to be removed first
        if (HasUnavailableItems)
        {
            return;
        }

        order = await BasketClient.CheckoutBasketAsync("user");

        if (order is null)
        {
            // The basket was already checked out or emptied elsewhere, so reload its current state.
            Navigation.Refresh();
            return;
        }

        // Confirm exactly what the Basket service ordered, at the prices it totaled
        lines = await ToCartLinesAsync(order.Items);
    }

    private async Task HandleClear()
    {
        await BasketClient.DeleteBasketAsync("user");

        // Re-request the page so the empty-cart state renders from a fresh basket load.
        Navigation.Refresh();
    }

    private async Task<List<CartLine>> ToCartLinesAsync(IReadOnlyCollection<BasketItem> items)
    {
        var missing = items.Select(i => i.ProductId).Distinct().Where(id => !catalogItems.ContainsKey(id)).ToArray();
        var found = await Task.WhenAll(missing.Select(CatalogService.GetItemAsync));

        foreach (var (productId, item) in missing.Zip(found))
        {
            catalogItems[productId] = item;
        }

        return [.. items.Select(i => new CartLine(i.ProductId, i.Quantity, i.UnitPrice, catalogItems[i.ProductId]))];
    }

    // UnitPrice is the price captured when the item was added, which is what the Basket service totals at checkout
    private record CartLine(int ProductId, int Quantity, decimal UnitPrice, CatalogItem? Item)
    {
        public decimal Total => UnitPrice * Quantity;
    }
}
