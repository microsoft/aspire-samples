@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Contoso Insurance</PageTitle>

<section class="hero hero--single">
    <div class="hero__copy">
        <p class="eyebrow">Error</p>
        <h1 class="hero__title">Something went wrong</h1>
        <p class="hero__lede">An error occurred while processing your request.</p>

        @if (ShowRequestId)
        {
            <p class="hero__lede">Request ID: <code>@RequestId</code></p>
        }

        <p class="hero__lede">
            Swapping to the <strong>Development</strong> environment displays more detailed information about what went wrong.
            <strong>The Development environment shouldn't be enabled for deployed applications</strong>, because it can leak
            sensitive information from exceptions to end users. For local debugging, set the <code>ASPNETCORE_ENVIRONMENT</code>
            environment variable to <strong>Development</strong> and restart the app.
        </p>

        <p><a href="">Back to claim photo intake</a></p>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
