<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="aspire-daily" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9/nuget/v3/index.json" />
    <add key="nuget-public" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="aspire-daily"><package pattern="Aspire*" /></packageSource>
    <packageSource key="nuget-public"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
