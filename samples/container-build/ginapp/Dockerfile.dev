# Development image (aspire run / aspire start): Air rebuilds and restarts the app when bind-mounted sources change.
ARG GO_VERSION=1.27.4
FROM golang:${GO_VERSION}

WORKDIR /app

RUN go install github.com/air-verse/air@v1.67.4

# Bake the module cache into the image so the container starts without downloading dependencies.
# The source itself is bind mounted over /app at run time.
COPY go.mod go.sum ./
RUN go mod download

CMD ["air", "-c", ".air.toml"]
